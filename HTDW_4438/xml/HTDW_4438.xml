                    <joint name="FR_calf_joint" pos="0 0 0" axis="0 1 0" limited="true" range="-2.5 -1.5" />
                    <geom type="mesh" contype="0" conaffinity="0" group="1" rgba="0.752941 0.752941 0.752941 1" mesh="FR_calf" />
                    <geom type="mesh" contype="1" conaffinity="1" group="3" rgba="0.8 0.8 0.8 1" mesh="FR_calf" />

                    <geom pos="0 0 -0.138" type="mesh" contype="0" conaffinity="0" group="1" rgba="0.298039 0.298039 0.298039 1" mesh="FR_foot" />
