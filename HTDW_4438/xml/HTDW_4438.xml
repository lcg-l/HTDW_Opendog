<mujoco model="HTDW_4438">
    <compiler angle="radian" meshdir="../meshes/" />
    <size njmax="500" nconmax="100" />

    <asset>
        <mesh name="base_link" file="base_link.STL" />
        <mesh name="FL_hip" file="FL_hip.STL" />
        <mesh name="FL_thigh" file="FL_thigh.STL" />
        <mesh name="FL_calf" file="FL_calf.STL" />
        <mesh name="FL_foot" file="FL_foot.STL" />
        <mesh name="FR_hip" file="FR_hip.STL" />
        <mesh name="FR_thigh" file="FR_thigh.STL" />
        <mesh name="FR_calf" file="FR_calf.STL" />
        <mesh name="FR_foot" file="FR_foot.STL" />
        <mesh name="RL_hip" file="RL_hip.STL" />
        <mesh name="RL_thigh" file="RL_thigh.STL" />
        <mesh name="RL_calf" file="RL_calf.STL" />
        <mesh name="RL_foot" file="RL_foot.STL" />
        <mesh name="RR_hip" file="RR_hip.STL" />
        <mesh name="RR_thigh" file="RR_thigh.STL" />
        <mesh name="RR_calf" file="RR_calf.STL" />
        <mesh name="RR_foot" file="RR_foot.STL" />
    </asset>

    <!-- 与 Isaac Gym 训练侧对齐:
         - sliding 摩擦 1.0  与 cfg.terrain.static_friction=1.0 一致
         - torsional/rolling 用 MuJoCo 默认值 (0.005 / 0.0001), 训练里不模拟,
           过大会导致脚部接触时抗旋转/抗滚动, 造成 sim2sim 不一致
         - frictionloss=0.0  训练 _compute_torques 不含库仑摩擦
         - armature=0.008419 与 cfg.asset.armature 一致 -->
    <default>
        <joint limited="true" damping="0.0" frictionloss="0.0" armature="0.008419"/>
        <geom contype="1" conaffinity="1" friction="1.0 0.005 0.0001" solref="0.02 0.8" solimp="0.9 0.95 0.01" />
    </default>

    <worldbody>
        <!-- Robot Base (Root Body) -->
        <body name="base_link" pos="0 0 0.25" quat="1 0 0 0">
            <joint name="float_base" type="free" limited="false"/>
            <inertial pos="-0.00150909 -0.00098889 0.00305206" quat="1 0 0 0" mass="2.38259971" diaginertia="0.00432585 0.00844472 0.00822046"/>
            <site name="imu" pos="0 0 0" />

            <!-- Base Link 视觉 + 碰撞 -->
            <geom type="mesh" contype="0" conaffinity="0" group="1" rgba="0.752941 0.752941 0.752941 1" mesh="base_link" />
            <geom type="mesh" contype="1" conaffinity="1" group="3" rgba="0.8 0.8 0.8 1" mesh="base_link" />

            <!-- Front Left Leg -->
            <body name="FL_hip" pos="0.11415 0.035 0">
            <inertial pos="-0.00110429 -9.855e-05 -0.000137" quat="0.450668 0.60653 0.309529 0.577244" mass="0.251695" diaginertia="4.61338e-05 4.37946e-05 3.81716e-05" />
            <joint name="FL_hip_joint" pos="0 0 0" axis="1 0 0" limited="true" range="-0.6 0.6" />
            <!-- 视觉geom -->
            <geom type="mesh" contype="0" conaffinity="0" group="1" rgba="0.752941 0.752941 0.752941 1" mesh="FL_hip" />
            <!-- 碰撞geom -->
            <geom type="mesh" contype="1" conaffinity="1" group="3" rgba="0.8 0.8 0.8 1" mesh="FL_hip" />

            <body name="FL_thigh" pos="0 0.0822 0">
                <inertial pos="-0.00114943 -0.0253357 -0.0099421" quat="0.98825 0.148595 0.0258141 0.0247813" mass="0.342256" diaginertia="0.000444623 0.000407618 0.000110138" />
                <joint name="FL_thigh_joint" pos="0 0 0" axis="0 1 0" limited="true" range="-1.57 3.49" />
                <geom type="mesh" contype="0" conaffinity="0" group="1" rgba="0.752941 0.752941 0.752941 1" mesh="FL_thigh" />
                <geom type="mesh" contype="1" conaffinity="1" group="3" rgba="0.8 0.8 0.8 1" mesh="FL_thigh" />

                <body name="FL_calf" pos="0 0 -0.12">
                    <inertial pos="0.00622014 1.43253e-05 -0.0698232" quat="0.707061 0.0161134 0.0164492 0.706778" mass="0.0402252" diaginertia="0.000112853 0.000110698 3.9154e-06" />
                    <joint name="FL_calf_joint" pos="0 0 0" axis="0 1 0" limited="true" range="-2.5 -1.5" />
                    <geom type="mesh" contype="0" conaffinity="0" group="1" rgba="0.752941 0.752941 0.752941 1" mesh="FL_calf" />
                    <geom type="mesh" contype="1" conaffinity="1" group="3" rgba="0.8 0.8 0.8 1" mesh="FL_calf" />

                    <!-- Foot -->
                    <geom pos="0 0 -0.13799" type="mesh" contype="0" conaffinity="0" group="1" rgba="0.298039 0.298039 0.298039 1" mesh="FL_foot" />
                    <geom pos="0 0 -0.13799" type="sphere" size="0.01675" contype="1" conaffinity="1" group="3" rgba="0.8 0.8 0.8 1" />
                    <site name="FL_foot_site" pos="0 0 -0.13799" size="0.01" rgba="0 0 1 0.5"/>
                </body>
            </body>
        </body>

        <!-- Front Right Leg -->
