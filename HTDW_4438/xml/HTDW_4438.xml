                </body>
            </body>
        </body>

        <!-- Rear Right Leg -->
        <body name="RR_hip" pos="-0.11415 -0.035 0">
            <inertial pos="0.00110429 9.855e-05 -0.000137" quat="0.60653 0.450668 0.577244 0.309529" mass="0.251695" diaginertia="4.61338e-05 4.37946e-05 3.81716e-05" />
